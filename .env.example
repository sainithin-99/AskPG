# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Any OpenAI-compatible chat endpoint works (hosted API or local Ollama).

LLM_BASE_URL=https://your-provider.example.com/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=replace-with-a-model-id

# Optional (defaults in src/generate.py): 
# LLM_MAX_TOKENS=1500
# LLM_MIN_GAP_S=1.6
# LLM_PRICE_IN_PER_M=0
# LLM_PRICE_OUT_PER_M=0

# Only for eval/judge.py (should be a different model from LLM_MODEL):
# JUDGE_MODEL=replace-with-a-judge-model-id
# JUDGE_MAX_TOKENS=8000

# Local Ollama example:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b
# LLM_MIN_GAP_S=0
